# ==============================================================================
# DeepGuard AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Never commit your '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# MongoDB Database Configuration
# ------------------------------------------------------------------------------
# Local MongoDB (default for local development):
MONGODB_URI=mongodb://127.0.0.1:27017
#
# Alternatively, MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=deepguard
MONGODB_TIMEOUT_MS=3000

# ------------------------------------------------------------------------------
# Security & Authentication Settings
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Upload & Inference Limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_FRAMES=60
VIDEO_FRAME_INTERVAL=15

# ------------------------------------------------------------------------------
# Model Paths (relative to project root or absolute)
# ------------------------------------------------------------------------------
IMAGE_MODEL_PATH=models/deepguard_v1.pth
AUDIO_MODEL_PATH=models/deepguard_audio.pth
DEVICE=auto
